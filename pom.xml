<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.Chagui68</groupId>
    <artifactId>MilitaryArsenal</artifactId>
    <version>1.0.0</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <paper.version>[26.2.build,)</paper.version>
        <slimefun.groupId>com.github.SlimefunGuguProject</slimefun.groupId>
        <slimefun.artifactId>Slimefun4</slimefun.artifactId>
        <slimefun.version>2025.1</slimefun.version>
        <legacy.source.dir>${project.build.directory}/legacy-src</legacy.source.dir>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper 26.2 API. CI builds with JDK 25 while retaining Java 21 bytecode. -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
            Compile against the public Slimefun4 API surface used by Slimefun Legacy.
            Slimefun itself is provided by the server and is never bundled into this addon.
        -->
        <dependency>
            <groupId>${slimefun.groupId}</groupId>
            <artifactId>${slimefun.artifactId}</artifactId>
            <version>${slimefun.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Paper exposes JOML at runtime; this declaration keeps display-entity code explicit. -->
        <dependency>
            <groupId>org.joml</groupId>
            <artifactId>joml</artifactId>
            <version>1.10.8</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.google.code.findbugs</groupId>
            <artifactId>jsr305</artifactId>
            <version>3.0.2</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <defaultGoal>clean package</defaultGoal>
        <finalName>SF_MilitaryArsenal_Legacy_v${project.version}</finalName>

        <!--
            Upstream 2.4.8 moved its source imports to the Drake Slimefun6 namespace.
            The Legacy fork intentionally keeps upstream source easy to sync, then prepares a
            generated compile tree that maps only that namespace back to the established
            Slimefun4 API package used by Slimefun Legacy/United/Gugu-compatible addons.
        -->
        <sourceDirectory>${legacy.source.dir}</sourceDirectory>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <excludes>
                    <exclude>structures/*.nbt</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <includes>
                    <include>structures/*.nbt</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>prepare-slimefun-legacy-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete dir="${legacy.source.dir}"/>
                                <copy todir="${legacy.source.dir}">
                                    <fileset dir="${project.basedir}/src/main/java" includes="**/*.java"/>
                                </copy>
                                <replaceregexp
                                        match="com\.github\.drakescraft_labs\.slimefun4"
                                        replace="io.github.thebusybiscuit.slimefun4"
                                        byline="true">
                                    <fileset dir="${legacy.source.dir}" includes="**/*.java"/>
                                </replaceregexp>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <encoding>UTF-8</encoding>
                    <proc>none</proc>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
